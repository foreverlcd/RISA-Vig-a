# Copia este archivo a .env.local (nunca se sube a git) y pon tu clave real.
# Sin esto, el botón "Redactar con IA" del panel de detalle falla con un
# mensaje claro y el dashboard sigue funcionando igual (usa la explicación
# automática de siempre) -- no es un requisito para que el resto funcione.

OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui

# Opcional -- modelo a usar en OpenRouter (formato "proveedor/modelo").
# Por defecto usa openai/gpt-4o-mini (barato y bueno). Otras opciones:
#   anthropic/claude-3.5-haiku
#   meta-llama/llama-3.1-8b-instruct:free   (gratis, calidad más variable)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Secreto para aceptar llamadas al webhook. Usa un valor largo y aleatorio;
# añade el mismo valor como encabezado x-risa-webhook-secret en tu integrador.
RISA_WEBHOOK_SECRET=reemplaza-esto-por-un-secreto-largo-y-aleatorio
